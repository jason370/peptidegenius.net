# Netlify custom headers (added 20260820 — perf)
#
# Versioned assets: every <script>/<link> in index.html carries a ?v=… query
# string that changes whenever the file changes, so the file at a given URL is
# effectively immutable. Cache it hard — this removes the 4-hour revalidation
# round-trips that were making repeat loads feel slow.
/assets/app/*
  Cache-Control: public, max-age=31536000, immutable

/assets/branding/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell must always be fresh — it's what points at the new ?v=… URLs.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker must never be cached stale, or updates stall behind it.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
