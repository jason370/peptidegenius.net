function makeResultSyringe(units,maxUnits,mlLabel,step){
  // Horizontal SVG syringe — Option B (clean modern) styling.
  // Major labeled ticks every 10u (10/20/30…) + minor unlabeled ticks every 5u between them (5/15/25…).
  const isEmpty=units===0;
  const over=!isEmpty&&units>maxUnits;
  const drawUnits=Math.min(Math.max(units,0),maxUnits);
  const frac=drawUnits/maxUnits;
  // Layout
  const NW=56,HW=18,BW=460,RW=44,EW=20;
  const BH=46;
  const H=100;
  const W=NW+HW+BW+RW+EW;
  const CY=H/2-2;
  const BX=NW+HW;
  const BY=CY-BH/2;
  const fillW=frac*BW;
  const fillEnd=BX+fillW;
  // Major ticks every 10u (labeled)
  const majorTicks=[];
  for(let u=10;u<=maxUnits;u+=10)majorTicks.push(u);
  const majorSVG=majorTicks.map(u=>{
    const tx=BX+(u/maxUnits)*BW;
    return '<line x1="'+tx+'" y1="'+BY+'" x2="'+tx+'" y2="'+(BY+8)+'" stroke="#5F5E5A" stroke-width="0.8"/>'
         + '<line x1="'+tx+'" y1="'+(BY+BH-8)+'" x2="'+tx+'" y2="'+(BY+BH)+'" stroke="#5F5E5A" stroke-width="0.8"/>'
         + '<text x="'+tx+'" y="'+(BY-5)+'" text-anchor="middle" font-size="10.5" fill="#444441" font-family="system-ui,sans-serif">'+u+'</text>';
  }).join('');
  // Minor ticks every 5u (unlabeled, shorter, lighter)
  const minorTicks=[];
  for(let u=5;u<maxUnits;u+=10)minorTicks.push(u);
  const minorSVG=minorTicks.map(u=>{
    const tx=BX+(u/maxUnits)*BW;
    return '<line x1="'+tx+'" y1="'+BY+'" x2="'+tx+'" y2="'+(BY+4)+'" stroke="#888780" stroke-width="0.5"/>'
         + '<line x1="'+tx+'" y1="'+(BY+BH-4)+'" x2="'+tx+'" y2="'+(BY+BH)+'" stroke="#888780" stroke-width="0.5"/>';
  }).join('');
  // Bold pill-shaped marker (Option B hallmark) at fillEnd
  const markerFill=over?'#DC2626':'#378ADD';
  const markerSVG=isEmpty?'':(
    '<line x1="'+fillEnd+'" y1="'+(BY-14)+'" x2="'+fillEnd+'" y2="'+(BY+BH+12)+'" stroke="'+markerFill+'" stroke-width="1.8"/>'
    +'<rect x="'+(fillEnd-34)+'" y="'+(BY+BH+12)+'" width="68" height="20" rx="10" fill="'+markerFill+'"/>'
    +'<text x="'+fillEnd+'" y="'+(BY+BH+26)+'" text-anchor="middle" font-size="11.5" font-weight="600" fill="#fff" font-family="system-ui,sans-serif">'+(Math.round(units*10)/10)+' units</text>'
  );
  // Thumb flange (flat rectangle T-shape, replaces old plus-cross cap)
  const R=BX+BW+RW;
  const flangeH=62,flangeStemW=6;
  const flangeSVG=
    '<rect x="'+R+'" y="'+(CY-flangeStemW/2)+'" width="14" height="'+flangeStemW+'" fill="#444441"/>'
    +'<rect x="'+R+'" y="'+(CY-flangeH/2)+'" width="'+flangeStemW+'" height="'+flangeH+'" fill="#2C2C2A"/>';
  const svg='<svg viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:680px;display:block;margin:0 auto;overflow:visible">'
    // Needle — simple line (Option B: no triangle tip, no bevel)
    +'<line x1="4" y1="'+CY+'" x2="'+NW+'" y2="'+CY+'" stroke="#888780" stroke-width="1.5"/>'
    // Hub — flat teal
    +'<rect x="'+NW+'" y="'+(CY-BH*0.42)+'" width="'+HW+'" height="'+(BH*0.84)+'" rx="3" fill="#1D9E75"/>'
    // Barrel — flat fill, thin stroke
    +'<rect x="'+BX+'" y="'+BY+'" width="'+BW+'" height="'+BH+'" rx="4" fill="#F8F6ED" stroke="#888780" stroke-width="0.5"/>'
    // Fill — solid flat color (no transparency)
    +'<clipPath id="bc'+maxUnits+'"><rect x="'+BX+'" y="'+BY+'" width="'+BW+'" height="'+BH+'" rx="4"/></clipPath>'
    +'<rect x="'+BX+'" y="'+BY+'" width="'+fillW+'" height="'+BH+'" clip-path="url(#bc'+maxUnits+')" fill="'+(over?'#DC2626':'#378ADD')+'"/>'
    // Plunger stopper — flat dark
    +(isEmpty?'':'<rect x="'+(fillEnd-10)+'" y="'+BY+'" width="12" height="'+BH+'" clip-path="url(#bc'+maxUnits+')" fill="#2C2C2A"/>')
    // Rod — flat light
    +'<rect x="'+(BX+fillW)+'" y="'+(CY-4)+'" width="'+(BW-fillW+RW)+'" height="8" fill="#D3D1C7"/>'
    +flangeSVG
    +minorSVG
    +majorSVG
    +markerSVG
    +'</svg>';
  const wrapHtml='<div style="padding:4px 0 2px;display:flex;flex-direction:column;align-items:center;gap:6px">'
    + svg
    + (over?'<div style="color:var(--accent-red-fg);font-size:12px;font-weight:500;margin-top:4px">Exceeds '+maxUnits+'u syringe capacity</div>':'')
    + '</div>';
  const div=document.createElement('div');
  div.innerHTML=wrapHtml;
  return div;
}

