<div class="page" id="pg-calc">
  <!-- Hero header card -->
  <div class="card" style="background:var(--calc-hero-bg);border:.5px solid var(--calc-accent-border);padding:1.25rem 1.5rem;margin-bottom:1rem">
    <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
      <div style="font-size:28px;line-height:1">💉</div>
      <div style="min-width:200px">
        <div style="font-size:19px;font-weight:800;color:var(--calc-headline);letter-spacing:-.015em;line-height:1.2">Peptide Reconstitution Calculator</div>
        <div style="font-size:12px;color:var(--calc-subheadline);margin-top:2px">Dial in your exact dose — results update as you select</div>
      </div>
      <select id="calc-from-inv" title="Load a saved peptide's vial size, BAC water, and dose" style="font-size:13px;font-weight:600;padding:10px 16px;width:240px;background:var(--calc-tile-bg);color:var(--calc-label);border:1.5px solid var(--calc-label);border-radius:10px;cursor:pointer;box-shadow:0 1px 2px rgba(24,95,165,0.08);font-family:inherit;margin-left:15%">
        <option value="" style="color:#1a1a18;background:#fff">📋 Load from inventory…</option>
      </select>
    </div>
  </div>

  <!-- Input steps card -->
  <div class="card" style="padding:1.5rem">
    <!-- two-column: syringe left | vial+water right -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.75rem;margin-bottom:1.25rem">
      <!-- Step 1: Syringe -->
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:1rem">
          <div style="width:26px;height:26px;border-radius:50%;background:var(--calc-badge-1-bg);color:var(--calc-badge-1-fg);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0">1</div>
          <div style="font-size:13px;font-weight:700;color:var(--color-text-primary)">Syringe size</div>
        </div>
        <div id="calc-syr-btns" style="display:flex;flex-direction:column;gap:10px"></div>
      </div>
      <!-- Right column: Step 2 + Step 3 stacked -->
      <div style="display:flex;flex-direction:column;gap:1.25rem">
        <!-- Step 2: Vial quantity -->
        <div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem">
            <div style="width:26px;height:26px;border-radius:50%;background:var(--calc-badge-2-bg);color:var(--calc-badge-2-fg);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0">2</div>
            <div style="font-size:13px;font-weight:700;color:var(--color-text-primary)">Peptide vial quantity</div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:7px;align-items:center">
            <div id="calc-vial-btns" style="display:contents"></div>
            <input type="number" id="calc-vial" min="0" step="any" placeholder="Other (mg)" style="width:110px;font-size:12px;text-align:center">
          </div>
        </div>
        <!-- Step 3: BAC water -->
        <div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem">
            <div style="width:26px;height:26px;border-radius:50%;background:var(--calc-badge-3-bg);color:var(--calc-badge-3-fg);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0">3</div>
            <div style="font-size:13px;font-weight:700;color:var(--color-text-primary)">Bacteriostatic water</div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:7px;align-items:center">
            <div id="calc-bac-btns" style="display:contents"></div>
            <input type="number" id="calc-bac" min="0" step="any" placeholder="Other (mL)" style="width:110px;font-size:12px;text-align:center">
          </div>
        </div>
      </div>
    </div>
    <!-- Steps 4 & 5: Dose + Frequency, side by side -->
    <div style="border-top:.5px solid var(--color-border-tertiary);padding-top:1.25rem;display:grid;grid-template-columns:1fr 1fr;gap:1.75rem">
      <!-- Step 4: Dose -->
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem">
          <div style="width:26px;height:26px;border-radius:50%;background:var(--calc-badge-4-bg);color:var(--calc-badge-4-fg);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0">4</div>
          <div style="font-size:13px;font-weight:700;color:var(--color-text-primary)">Your dose</div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:7px;align-items:center">
          <div id="calc-dose-btns" style="display:contents"></div>
          <input type="number" id="calc-dose" min="0" step="any" placeholder="Other" style="width:90px;font-size:12px;text-align:center">
          <select id="calc-dose-unit" style="width:58px;font-size:11px"><option value="mcg">mcg</option><option value="mg">mg</option><option value="pill">pill</option></select>
        </div>
      </div>
      <!-- Step 5: Frequency -->
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem">
          <div style="width:26px;height:26px;border-radius:50%;background:var(--calc-badge-5-bg);color:var(--calc-badge-5-fg);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0">5</div>
