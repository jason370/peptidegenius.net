// Populate the shot-log form fields from the most recent shot of `pepName`,
// falling back to the inventory's planned dose/recon when no prior shots
// exist. Notes/tags/severity are NEVER carried forward — those are
// observation data tied to a specific shot, not defaults for the next one.
function autofillShotLogForPep(pepName){
  if(!pepName)return;
  const shots=(S.shots||[]).filter(s=>s.peptide===pepName);
  // Sort most-recent first: by date desc, then by id desc as a tiebreaker
  // (id increments on every logged shot)
  const lastShot=shots.length
    ? shots.slice().sort((a,b)=>{
        if(a.date!==b.date)return a.date<b.date?1:-1;
        return (b.id||0)-(a.id||0);
      })[0]
    : null;
  if(lastShot){
    if(lastShot.dose!=null){
      sv('lg-dose',lastShot.dose);
      sv('lg-dose-unit',lastShot.doseUnit||'mcg');
    }
    if(lastShot.volume!=null&&lastShot.volumeUnit!=='pill'){
      const lastVolUnit=lastShot.volumeUnit||'mL';
      sv('lg-vol-unit',lastVolUnit);
      sv('lg-vol',lastShot.volume);
    }
    if(lastShot.site){
      const siteEl=g('lg-site');
      // v10: do NOT override the site dropdown if the user already has a
      // value selected. Most users do multiple shots in one session at the
      // same location even when switching peptides; preserving their pick
      // matches that workflow. The autofill below from inventory still
      // applies for dose/volume — we only protect the site field.
      const siteAlreadyChosen = !!(siteEl && siteEl.value);
      if(siteEl && !siteAlreadyChosen && [...siteEl.options].some(o=>o.value===lastShot.site)){
        siteEl.value=lastShot.site;
      }
    }
    return;
  }
  // No prior shot — fall back to inventory's planned dose
  const pep=(S.inv||[]).find(i=>i.name===pepName);
  if(!pep)return;
  if(pep.dose!=null&&pep.dose>0){
    sv('lg-dose',pep.dose);
    sv('lg-dose-unit',pep.doseUnit||'mcg');
  }
  if(pep.vialMg>0&&pep.reconBacMl>0&&pep.dose>0){
    const doseMg=(pep.doseUnit==='mg')?pep.dose:pep.dose/1000;
    const volMl=doseMg/(pep.vialMg/pep.reconBacMl);
    const volUnit=gv('lg-vol-unit')||'mL';
    const volOut=volUnit==='units'?Math.round(volMl*100):Math.round(volMl*1000)/1000;
    sv('lg-vol',volOut);
  }
}
