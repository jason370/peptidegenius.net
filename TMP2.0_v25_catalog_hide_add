    chev.style.transform = min ? 'rotate(-90deg)' : '';
    btn.setAttribute('aria-expanded', min ? 'false' : 'true');
  }
  function wire(){
    const btn = document.getElementById('interval-card-toggle');
    if (!btn || btn.__tmpWired) return false;
    btn.__tmpWired = true;
    btn.addEventListener('click', e => {
      e.preventDefault();
